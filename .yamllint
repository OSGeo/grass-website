---

extends: default

rules:
  comments:
    level: error
    min-spaces-from-content: 1
  document-start:
    level: error
  line-length:
    level: error
    max: 120
    allow-non-breakable-inline-mappings: true
  truthy: disable

ignore:
  - node_modules/
  - public/
  - content/
  - themes/
  - data/
